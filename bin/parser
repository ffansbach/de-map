#!/usr/bin/env php
<?php

declare(strict_types=1);

use FreifunkKarte\Command\CompareCommand;
use FreifunkKarte\Command\FixturesBuildCommand;
use FreifunkKarte\Command\RunCommand;
use FreifunkKarte\Command\RunsCommand;
use FreifunkKarte\Command\SourcesAuditCommand;
use Symfony\Component\Console\Application;

require __DIR__ . '/../vendor/autoload.php';

$application = new Application('freifunk-karte parser');
$application->addCommand(new SourcesAuditCommand());
$application->addCommand(new FixturesBuildCommand());
$application->addCommand(new RunCommand());
$application->addCommand(new CompareCommand());
$application->addCommand(new RunsCommand());
$application->run();
