# New code (src/, bin/, tests for it): strict. Legacy code: phpstan-legacy.neon
parameters:
    level: 8
    paths:
        - src
        - bin
        - tests/Audit
        - tests/Http
        - tests/Source
        - tests/Community
        - tests/Pipeline
        - tests/Output
        - tests/Legacy
        - tests/Parser
        - tests/Model
    phpVersion: 80300
