# New code (src/, bin/, tests for it): strict. The plain-PHP web part: phpstan-weblib.neon (web/lib) and phpstan-web.neon (upload.php, as PHP 7.2)
parameters:
    scanFiles:
        - web/upload.php
    level: 8
    paths:
        - src
        - bin
        - public-admin
        - tests/Audit
        - tests/Http
        - tests/Source
        - tests/Community
        - tests/Pipeline
        - tests/Output
        - tests/Config
        - tests/Command
        - tests/Run
        - tests/Log
        - tests/Admin
        - tests/Publish
        - tests/Web
        - tests/Support
        - tests/Parser
        - tests/Model
    phpVersion: 80401
