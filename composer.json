{
  "name": "stilgarbf/freifunk-karte",
  "description": "Sammelt die Knotenlisten aller deutschen Freifunk-Communities und zeigt sie auf einer Karte: Parser, Auslieferung, Karte",
  "type": "project",
  "homepage": "https://www.freifunk-karte.de/",
  "minimum-stability": "stable",
  "license": "GPL-2.0-only",
  "authors": [
    {
      "name": "Tino Dietel",
      "email": "tino.dietel@projekt2k.de"
    }
  ],
  "require": {
    "php": ">=8.4.1",
    "ext-curl": "*",
    "guzzlehttp/guzzle": "^7.8",
    "influxdata/influxdb-client-php": "^3.5",
    "justinrainbow/json-schema": "^6.14",
    "monolog/monolog": "^3.8",
    "php-http/guzzle7-adapter": "^1.0",
    "symfony/console": "^7.3"
  },
  "autoload": {
    "psr-4": {
      "FreifunkKarte\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FreifunkKarte\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "stan": [
      "phpstan analyse --memory-limit=1G",
      "phpstan analyse --memory-limit=1G -c phpstan-weblib.neon",
      "phpstan analyse --memory-limit=1G -c phpstan-web.neon"
    ],
    "docs": "php bin/check-docs",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix",
    "check": [
      "@cs",
      "@stan",
      "@test"
    ]
  }
}
