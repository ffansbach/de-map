parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#3 \$value of function curl_setopt expects 0\|2, false given\.$#'
			identifier: argument.type
			count: 1
			path: lib/CurlHelper.php

		-
			message: '#^Variable \$url_parsed in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.variable
			count: 1
			path: lib/CurlHelper.php

		-
			message: '#^Instantiated class ffmap\\ErrorException not found\.$#'
			identifier: class.notFound
			count: 1
			path: lib/HealthCheck.php

		-
			message: '#^Throwing object of an unknown class ffmap\\ErrorException\.$#'
			identifier: class.notFound
			count: 1
			path: lib/HealthCheck.php

		-
			message: '#^PHPDoc tag @throws with type InfluxDB\\Exception is not subtype of Throwable$#'
			identifier: throws.notThrowable
			count: 1
			path: lib/InfluxLog.php

		-
			message: '#^Property Lib\\InfluxLog\:\:\$dataBase has unknown class InfluxDB\\Client as its type\.$#'
			identifier: class.notFound
			count: 1
			path: lib/InfluxLog.php

		-
			message: '#^Property Lib\\InfluxLog\:\:\$dataBase has unknown class InfluxDB\\Database as its type\.$#'
			identifier: class.notFound
			count: 1
			path: lib/InfluxLog.php

		-
			message: '#^Call to function array_merge\(\) on a separate line has no effect\.$#'
			identifier: function.resultUnused
			count: 1
			path: lib/NodeListParser.php

		-
			message: '#^Negated boolean expression is always true\.$#'
			identifier: booleanNot.alwaysTrue
			count: 1
			path: lib/NodeListParser.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$url$#'
			identifier: parameter.notFound
			count: 1
			path: lib/NodeListParser.php

		-
			message: '#^PHPDoc tag @return with type mixed is not subtype of native type array\.$#'
			identifier: return.phpDocType
			count: 1
			path: lib/NodeListParser.php

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 1
			path: lib/NodeListParser.php

		-
			message: '#^Variable \$routers in empty\(\) always exists and is always falsy\.$#'
			identifier: empty.variable
			count: 1
			path: lib/NodeListParser.php

		-
			message: '#^Call to method query\(\) on an unknown class ffmap\\mysqli\.$#'
			identifier: class.notFound
			count: 2
			path: lib/log.php

		-
			message: '#^Parameter \$db of method ffmap\\log\:\:__construct\(\) has invalid type ffmap\\mysqli\.$#'
			identifier: class.notFound
			count: 2
			path: lib/log.php

		-
			message: '#^Property ffmap\\log\:\:\$db has unknown class ffmap\\mysqli as its type\.$#'
			identifier: class.notFound
			count: 2
			path: lib/log.php

		-
			message: '#^Call to static method validate\(\) on an unknown class Jsv4\.$#'
			identifier: class.notFound
			count: 1
			path: lib/parser/NodeList.php

		-
			message: '#^PHPDoc tag @throws with type ffmap\\Exception is not subtype of Throwable$#'
			identifier: throws.notThrowable
			count: 1
			path: tests/CommunityCacheHandlerTest.php

		-
			message: '#^PHPDoc tag @param for parameter \$community with type array is incompatible with native type object\.$#'
			identifier: parameter.phpDocType
			count: 1
			path: tests/CommunityDebugTest.php
